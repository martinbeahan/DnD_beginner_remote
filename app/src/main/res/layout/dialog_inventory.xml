<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dungeon_panel"
    android:padding="14dp">

    <TextView
        android:id="@+id/invGoldText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/invHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/parchment_dark"
        android:textSize="11sp"
        android:paddingBottom="8dp"
        android:text="Equip class-tagged gear only if it matches your class. Upgrade spends gold. Sell returns gold (confirm)." />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp">
        <LinearLayout
            android:id="@+id/invItemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
