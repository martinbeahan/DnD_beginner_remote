<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dungeon_panel"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/sheetPortrait"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:padding="5dp"
                android:background="@drawable/bg_portrait_frame"
                android:contentDescription="Portrait"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/sheetName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_bright"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/sheetClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/parchment"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/sheetGold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sheetHpLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="HP"
            android:textColor="@color/parchment"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/sheetHpBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/bg_hp_bar" />

        <TextView
            android:id="@+id/sheetResources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/parchment"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sheetXpLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="XP"
            android:textColor="@color/parchment"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/sheetXpBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_xp_bar" />

        <TextView
            android:id="@+id/sheetClassTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gold"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ATTRIBUTES"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:id="@+id/sheetStatsRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">
            <TextView android:id="@+id/sheetStatStr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/sheetStatDex" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/sheetStatCon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sheetStatsRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView android:id="@+id/sheetStatInt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/sheetStatWis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/sheetStatCha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat_chip" android:textColor="@color/parchment" android:textSize="11sp" android:gravity="center" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheetStatTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/parchment_dark"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/sheetEquipped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/parchment"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sheetPointsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/sheetInventory"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="48dp"
            android:text="Open Inventory" />

        <Button
            android:id="@+id/sheetLevelUp"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:text="Assign attribute points"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
