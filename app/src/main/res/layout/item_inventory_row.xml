<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_shop_row"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/invItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/parchment"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/invItemMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/parchment_dark"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="end">

        <Button
            android:id="@+id/invEquipBtn"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:minHeight="44dp"
            android:text="Equip"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/invUpgradeBtn"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:minHeight="44dp"
            android:text="Upgrade"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/invSellBtn"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:minHeight="44dp"
            android:text="Sell"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
