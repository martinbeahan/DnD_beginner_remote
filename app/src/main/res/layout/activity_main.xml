<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121820">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#E0101820"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/playerStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading Party..."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="5" />

        <Button
            android:id="@+id/btnJournal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#FFD700"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sheet"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#00BFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/roomDescText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:background="#99000000"
        android:padding="8dp"
        android:text="Room description..."
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:textStyle="italic" />

    <!-- Visible battle stage -->
    <LinearLayout
        android:id="@+id/battleArena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/roomDescText"
        android:layout_above="@id/bottomControls"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:background="#FF1A2433">

        <LinearLayout
            android:id="@+id/partyColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|start" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VS"
            android:textColor="#80FFD700"
            android:textStyle="bold"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/enemyColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#F0101820">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center">

            <Button android:id="@+id/btnAttack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Atk" android:textSize="12sp" />
            <Button android:id="@+id/id_spacer1" android:layout_width="2dp" android:layout_height="match_parent" android:visibility="invisible"/>
            <Button android:id="@+id/btnSpecial" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Spec" android:textSize="12sp" />
            <Button android:id="@+id/btnInteract" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Srch" android:textSize="12sp" />
            <Button android:id="@+id/btnHeal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Heal" android:textSize="12sp" />
            <Button android:id="@+id/btnRest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rest" android:textSize="12sp" />
            <Button android:id="@+id/btnReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">
            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Roleplay / Chat..."
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:background="@android:color/transparent"
                android:padding="8dp"/>
            <Button
                android:id="@+id/btnSendChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="#FFD700"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Journal &amp; Chat"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="italic" />
            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/combatLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome! Your turn."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
