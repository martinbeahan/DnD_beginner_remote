<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dungeon_bg"
    android:padding="8dp">

    <!-- Slim top HUD -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dungeon_panel"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/turnBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your turn"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/playerStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Room 1"
                android:textColor="@color/parchment"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/btnJournal"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="Log"
            android:textSize="11sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSheet"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:text="Sheet"
            android:textSize="11sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnHelp"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:layout_marginStart="4dp"
            android:text="?"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Parchment room blurb -->
    <TextView
        android:id="@+id/roomDescText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_parchment"
        android:padding="10dp"
        android:text="The torchlight flickers…"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Battle stage (main focus) -->
    <LinearLayout
        android:id="@+id/battleArena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/roomDescText"
        android:layout_above="@id/bottomControls"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:background="@drawable/bg_battle_stage">

        <LinearLayout
            android:id="@+id/partyColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|start" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VS"
            android:textSize="22sp"
            android:textColor="@color/gold"
            android:padding="6dp" />

        <LinearLayout
            android:id="@+id/enemyColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|end" />
    </LinearLayout>

    <!-- Bottom: actions + slim event ticker -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_dungeon_panel"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/combatLogScroll"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/combatLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The adventure begins…"
                android:textColor="@color/parchment"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </ScrollView>

        <!-- Hidden chat row kept for code compatibility; collapsed by default height 0 via gone -->
        <LinearLayout
            android:id="@+id/chatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Say something…"
                android:textColor="@color/parchment"
                android:textColorHint="#80E8D5A3"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnSendChat"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnAttack"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="⚔&#10;Attack"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnSpecial"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="✦&#10;Special"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnHeal"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="⚗&#10;Potion"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnInteract"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="🔍&#10;Search"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnRest"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="🌙&#10;Rest"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/btnReset"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="Reset"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <!-- spacer id kept for old code references if any -->
                <Button android:id="@+id/id_spacer1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keep logScrollView id for compatibility (unused visually) -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <include
        layout="@layout/overlay_dice"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
