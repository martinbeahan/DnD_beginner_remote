<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_shop_row"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginBottom="6dp"
    android:minHeight="52dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/statAssignName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/statAssignCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/parchment"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <Button
        android:id="@+id/statAssignMinus"
        style="@style/Widget.DnD.ActionButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="−"
        android:textSize="18sp"
        android:padding="0dp" />

    <TextView
        android:id="@+id/statAssignAdd"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="+0" />

    <Button
        android:id="@+id/statAssignPlus"
        style="@style/Widget.DnD.ActionButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="+"
        android:textSize="18sp"
        android:padding="0dp" />
</LinearLayout>
