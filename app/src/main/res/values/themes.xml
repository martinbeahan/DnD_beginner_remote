<resources>
    <style name="Theme.DnDBeginnerRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/parchment_dark</item>
        <item name="colorSecondaryVariant">@color/stone</item>
        <item name="colorOnSecondary">@color/parchment</item>
        <item name="android:statusBarColor">@color/dungeon_bg</item>
        <item name="android:windowBackground">@color/dungeon_bg</item>
        <item name="android:navigationBarColor">@color/dungeon_bg</item>
        <item name="android:textColorPrimary">@color/parchment</item>
        <!-- Do NOT set buttonStyle globally — Samsung AlertDialogs crash/mis-draw with custom Material backgrounds. -->
    </style>

    <style name="Widget.DnD.ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_action_btn</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="backgroundTint">@null</item>
    </style>
</resources>
