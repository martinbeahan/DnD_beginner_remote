<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DnDBeginnerRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/parchment_dark</item>
        <item name="colorSecondaryVariant">@color/stone</item>
        <item name="colorOnSecondary">@color/parchment</item>
        <item name="android:statusBarColor">@color/dungeon_bg</item>
        <item name="android:windowBackground">@color/dungeon_bg</item>
        <item name="android:navigationBarColor">@color/dungeon_bg</item>
        <item name="android:textColorPrimary">@color/parchment</item>
        <!-- Do NOT set buttonStyle globally — Samsung AlertDialogs crash/mis-draw with custom Material backgrounds. -->
    </style>

    <style name="Widget.DnD.ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_action_btn</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.DnD.HudChip" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_hud_chip</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Parent required: dotted Text.DnD.* styles imply style/Text.DnD for AAPT. -->
    <style name="Text.DnD" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/parchment</item>
    </style>

    <style name="Text.DnD.SectionLabel" parent="Text.DnD">
        <item name="android:textColor">@color/gold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingTop">4dp</item>
    </style>
</resources>
