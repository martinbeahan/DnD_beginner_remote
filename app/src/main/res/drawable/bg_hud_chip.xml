<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF4E342E"/>
            <stroke android:width="1.5dp" android:color="@color/gold_bright"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC3A2A20"/>
            <stroke android:width="1dp" android:color="@color/gold_dim"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
