<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1410" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/bg_battle_vault"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#80C9A227" />
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
