<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#663A322C"/>
            <stroke android:width="1dp" android:color="#668B5A2B"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5D4037"/>
            <stroke android:width="2dp" android:color="@color/gold"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4E342E"/>
            <stroke android:width="1dp" android:color="@color/gold"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
