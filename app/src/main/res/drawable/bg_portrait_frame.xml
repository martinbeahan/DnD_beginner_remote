<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2118" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#66FFE08A" />
            <corners android:radius="8dp" />
            <solid android:color="#221A1410" />
        </shape>
    </item>
</layer-list>
