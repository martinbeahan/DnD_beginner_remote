<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#55FFE08A"/>
            <stroke android:width="3dp" android:color="@color/gold_bright"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#CCFFE08A"/>
            <corners android:radius="11dp"/>
            <solid android:color="#22E0C060"/>
        </shape>
    </item>
</layer-list>
