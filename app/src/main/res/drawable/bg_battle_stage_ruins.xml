<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1410" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/bg_battle_ruins"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
    <!-- Cheap depth: top/bottom shade layers (pseudo-parallax read) -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#66000000"
                android:centerColor="#00000000"
                android:endColor="#88000000"
                android:centerY="0.45" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#80D0A060" />
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
